APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///whatsapp_bot.db
PORT=5000
SCHEDULER_INTERVAL=10
ENABLE_SCHEDULER=true
MAX_RETRIES=3
RETRY_BACKOFF=60
RATE_LIMIT_ENABLED=true
