WHATSAPP_PROVIDER=pywhatkit
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
